{
  "version": 2,
  "buildCommand": "echo 'no build needed'",
  "outputDirectory": "public",
  "functions": {
    "api/convert.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/optimize.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/api/convert", "destination": "/api/convert.js" },
    { "source": "/api/optimize", "destination": "/api/optimize.js" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
